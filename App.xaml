<Application x:Class="AgentDock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Night-time party screen palette -->
        <Color x:Key="BgTopColor">#1B2142</Color>
        <Color x:Key="BgBottomColor">#0E1124</Color>
        <SolidColorBrush x:Key="FrameBrush" Color="#080A16"/>
        <SolidColorBrush x:Key="CardEdgeBrush" Color="#3A4478"/>
        <SolidColorBrush x:Key="SelectBrush" Color="#FFD84D"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1F3FF"/>
        <!-- Secondary text kept at 4.5:1+ on the card fill for readability -->
        <SolidColorBrush x:Key="MutedBrush" Color="#C4CAEC"/>
        <SolidColorBrush x:Key="FaintBrush" Color="#A3AAD2"/>
        <SolidColorBrush x:Key="InkBrush" Color="#141833"/>
        <SolidColorBrush x:Key="BubbleBrush" Color="#2A3160"/>
        <SolidColorBrush x:Key="PillBrush" Color="#2B335F"/>

        <!-- "Types" -->
        <SolidColorBrush x:Key="WorkingBrush" Color="#F8D030"/>
        <SolidColorBrush x:Key="WaitingBrush" Color="#FF6B4A"/>
        <SolidColorBrush x:Key="FinishedBrush" Color="#62D86E"/>
        <SolidColorBrush x:Key="IdleBrush" Color="#A890F0"/>
        <SolidColorBrush x:Key="EndedBrush" Color="#6E7391"/>

        <!-- HP bar -->
        <SolidColorBrush x:Key="HpHighBrush" Color="#5EE07A"/>
        <SolidColorBrush x:Key="HpMidBrush" Color="#F8D030"/>
        <SolidColorBrush x:Key="HpLowBrush" Color="#F05050"/>

        <FontFamily x:Key="GameFont">Bahnschrift</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </Application.Resources>
</Application>
