<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AgentDock</AssemblyName>
    <RootNamespace>AgentDock</RootNamespace>
    <Product>Sessiondex</Product>
    <!-- Shown as the app name on Windows notifications -->
    <AssemblyTitle>Sessiondex</AssemblyTitle>
    <Version>1.0.0</Version>
    <!-- The manifest's DPI settings are for WPF; WinForms is only used for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- Reproducible builds that don't embed the builder's local folder paths -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Update="hook\agent-dock-hook.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
