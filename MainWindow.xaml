<Window x:Class="AgentDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AgentDock"
        Title="Session Dock"
        Width="320" Height="800"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual" Left="-10000" Top="0"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource BgTopColor}" Offset="0"/>
            <GradientStop Color="{StaticResource BgBottomColor}" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Geometry x:Key="Sparkle">M 0,-4 L 1,-1 L 4,0 L 1,1 L 0,4 L -1,1 L -4,0 L -1,-1 Z</Geometry>

        <RadialGradientBrush x:Key="HabitatWorking"><GradientStop Color="#66F8D030" Offset="0"/><GradientStop Color="#00F8D030" Offset="1"/></RadialGradientBrush>
        <RadialGradientBrush x:Key="HabitatWaiting"><GradientStop Color="#77FF6B4A" Offset="0"/><GradientStop Color="#00FF6B4A" Offset="1"/></RadialGradientBrush>
        <RadialGradientBrush x:Key="HabitatFinished"><GradientStop Color="#5562D86E" Offset="0"/><GradientStop Color="#0062D86E" Offset="1"/></RadialGradientBrush>
        <RadialGradientBrush x:Key="HabitatIdle"><GradientStop Color="#44A890F0" Offset="0"/><GradientStop Color="#00A890F0" Offset="1"/></RadialGradientBrush>

        <LinearGradientBrush x:Key="CardFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#252C55" Offset="0"/>
            <GradientStop Color="#1B2146" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WaitingCardFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40263A" Offset="0"/>
            <GradientStop Color="#2A1C33" Offset="1"/>
        </LinearGradientBrush>

        <!-- Slim scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" Margin="2,2" CornerRadius="2" Background="#3A4478"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="T" Property="Background" Value="#5662A0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33405F"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Capture-ball slot in the party bar -->
        <DataTemplate x:Key="PartyBall" DataType="{x:Type local:SessionInfo}">
            <Grid x:Name="Ball" Width="15" Height="15" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                <Grid.ToolTip>
                    <TextBlock><Run Text="{Binding Project, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding StatusLabel, Mode=OneWay}"/></TextBlock>
                </Grid.ToolTip>
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0" ScaleY="0"/>
                        <RotateTransform/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Ellipse Fill="#F4F4F8" Stroke="#0B0E1E" StrokeThickness="1.2"/>
                <Path x:Name="Top" Data="M 0.6,7.5 A 6.9,6.9 0 0 1 14.4,7.5 Z" Fill="{StaticResource IdleBrush}"/>
                <Rectangle Height="1.6" Fill="#0B0E1E" VerticalAlignment="Center" Margin="0.5,0"/>
                <Ellipse Width="5.5" Height="5.5" Fill="#F4F4F8" Stroke="#0B0E1E" StrokeThickness="1.3"/>
            </Grid>
            <DataTemplate.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="Ball">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Ball" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.45">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Ball" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.45">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Working">
                    <Setter TargetName="Top" Property="Fill" Value="{StaticResource WorkingBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Finished">
                    <Setter TargetName="Top" Property="Fill" Value="{StaticResource FinishedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Ended">
                    <Setter TargetName="Top" Property="Fill" Value="{StaticResource EndedBrush}"/>
                    <Setter TargetName="Ball" Property="Opacity" Value="0.4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Waiting">
                    <Setter TargetName="Top" Property="Fill" Value="{StaticResource WaitingBrush}"/>
                    </DataTrigger>
                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Status}" Value="Waiting"/><Condition Binding="{Binding DataContext.CalmMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/></MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard x:Name="BallWobble">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Ball" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(RotateTransform.Angle)">
                                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="-20"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="20"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="-12"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="0"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:1.3" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions><MultiDataTrigger.ExitActions><StopStoryboard BeginStoryboardName="BallWobble"/></MultiDataTrigger.ExitActions></MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One party member (session) -->
        <DataTemplate x:Key="SessionCard" DataType="{x:Type local:SessionInfo}">
            <Grid x:Name="Root" Margin="14,0,12,12" Cursor="Hand" Background="Transparent"
                  ToolTip="Click to open this session" MouseLeftButtonUp="Card_Click">
                <Grid.RenderTransform>
                    <TranslateTransform X="40"/>
                </Grid.RenderTransform>
                <Grid.Opacity>0</Grid.Opacity>

                <!-- Menu cursor shown on hover -->
                <Path x:Name="Cursor" Data="M 0,0 L 6,5 L 0,10 Z" Fill="{StaticResource SelectBrush}"
                      HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-11,30,0,0" Opacity="0">
                    <Path.RenderTransform><TranslateTransform/></Path.RenderTransform>
                </Path>

                <!-- Soft glow behind the card when it needs you -->
                <Border x:Name="Glow" CornerRadius="13" Background="#FF6B4A" Opacity="0" Margin="2">
                    <Border.Effect><BlurEffect Radius="16"/></Border.Effect>
                </Border>

                <Border x:Name="Frame" CornerRadius="13" Background="{StaticResource FrameBrush}" Padding="2">
                    <Border x:Name="Card" CornerRadius="11" BorderThickness="1.5"
                            Background="{StaticResource CardFill}" BorderBrush="{StaticResource CardEdgeBrush}">
                        <Grid Margin="8,9,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="AvatarColumn" Width="62"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Critter -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                <Grid x:Name="Avatar" Width="60" Height="58">
                                    <Ellipse x:Name="Habitat" Width="56" Height="56" Fill="{StaticResource HabitatIdle}"/>
                                    <Ellipse x:Name="Shadow" Width="26" Height="5" Fill="#55000000" VerticalAlignment="Bottom"
                                             Margin="0,0,0,7" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Image x:Name="Sprite" Source="{Binding CritterImage}" Width="40" Height="40"
                                           VerticalAlignment="Bottom" Margin="0,0,0,9"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           RenderTransformOrigin="0.5,1" ToolTip="{Binding CritterName}">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <TranslateTransform/>
                                                <ScaleTransform/>
                                                <RotateTransform/>
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>

                                    <Canvas Width="60" Height="58" IsHitTestVisible="False">
                                        <!-- Working sparkles -->
                                        <Path x:Name="SparkA" Data="{StaticResource Sparkle}" Fill="{StaticResource WorkingBrush}" Canvas.Left="9" Canvas.Top="12" Opacity="0"/>
                                        <Path x:Name="SparkB" Data="{StaticResource Sparkle}" Fill="#FFF6C8" Canvas.Left="51" Canvas.Top="16" Opacity="0"/>
                                        <Path x:Name="SparkC" Data="{StaticResource Sparkle}" Fill="{StaticResource WorkingBrush}" Canvas.Left="49" Canvas.Top="44" Opacity="0"/>

                                        <!-- Finished star burst -->
                                        <Path x:Name="Star1" Data="{StaticResource Sparkle}" Fill="#FFE36E" Canvas.Left="30" Canvas.Top="30" Opacity="0"><Path.RenderTransform><TranslateTransform/></Path.RenderTransform></Path>
                                        <Path x:Name="Star2" Data="{StaticResource Sparkle}" Fill="#9CF5A6" Canvas.Left="30" Canvas.Top="30" Opacity="0"><Path.RenderTransform><TranslateTransform/></Path.RenderTransform></Path>
                                        <Path x:Name="Star3" Data="{StaticResource Sparkle}" Fill="#FFFFFF" Canvas.Left="30" Canvas.Top="30" Opacity="0"><Path.RenderTransform><TranslateTransform/></Path.RenderTransform></Path>
                                        <Path x:Name="Star4" Data="{StaticResource Sparkle}" Fill="#FFE36E" Canvas.Left="30" Canvas.Top="30" Opacity="0"><Path.RenderTransform><TranslateTransform/></Path.RenderTransform></Path>
                                        <Path x:Name="Star5" Data="{StaticResource Sparkle}" Fill="#9CF5A6" Canvas.Left="30" Canvas.Top="30" Opacity="0"><Path.RenderTransform><TranslateTransform/></Path.RenderTransform></Path>
                                        <Path x:Name="Star6" Data="{StaticResource Sparkle}" Fill="#FFFFFF" Canvas.Left="30" Canvas.Top="30" Opacity="0"><Path.RenderTransform><TranslateTransform/></Path.RenderTransform></Path>

                                        <!-- Idle zzz -->
                                        <TextBlock x:Name="ZA" Text="z" FontFamily="{StaticResource GameFont}" FontWeight="Bold" FontSize="11"
                                                   Foreground="{StaticResource IdleBrush}" Canvas.Left="44" Canvas.Top="14" Opacity="0">
                                            <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock x:Name="ZB" Text="Z" FontFamily="{StaticResource GameFont}" FontWeight="Bold" FontSize="13"
                                                   Foreground="{StaticResource IdleBrush}" Canvas.Left="48" Canvas.Top="10" Opacity="0">
                                            <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                                        </TextBlock>

                                        <!-- Waiting "!" bubble -->
                                        <Border x:Name="Bang" Canvas.Left="40" Canvas.Top="0" Width="17" Height="19" CornerRadius="6"
                                                Background="#FFFFFF" BorderBrush="#0B0E1E" BorderThickness="1.2"
                                                RenderTransformOrigin="0.3,1" Opacity="0">
                                            <Border.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="0" ScaleY="0"/>
                                                    <TranslateTransform/>
                                                </TransformGroup>
                                            </Border.RenderTransform>
                                            <TextBlock Text="!" FontFamily="{StaticResource GameFont}" FontWeight="Bold" FontSize="13"
                                                       Foreground="{StaticResource WaitingBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Canvas>
                                </Grid>
                                <Grid x:Name="LevelBox" HorizontalAlignment="Center" Margin="0,1,0,0">
                                    <TextBlock x:Name="LevelLabel" Text="{Binding LevelText, NotifyOnTargetUpdated=True}" TargetUpdated="LevelLabel_TargetUpdated"
                                               FontFamily="{StaticResource GameFont}" FontWeight="SemiBold" FontSize="11"
                                               Foreground="{StaticResource SelectBrush}" HorizontalAlignment="Center"
                                               ToolTip="Level goes up as the agent uses tools" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform><ScaleTransform/></TextBlock.RenderTransform>
                                    </TextBlock>
                                    <!-- "LV UP!" floats up when the level changes -->
                                    <TextBlock x:Name="LevelUp" Text="LV UP!" FontFamily="{StaticResource GameFont}" FontWeight="Bold" FontSize="10"
                                               Foreground="#7CF7FF" HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                                        <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>

                            <!-- Details -->
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Project}" FontFamily="{StaticResource GameFont}" FontWeight="SemiBold" FontSize="15.5"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Cwd}"/>
                                    <Button x:Name="DismissBtn" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;"
                                            Width="20" Height="20" Margin="4,-3,-4,0" ToolTip="Remove card" Click="Dismiss_Click"
                                            Visibility="Hidden"/>
                                </Grid>
                                <!-- Git branch, so two sessions in one repo are easy to tell apart -->
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0"
                                            Visibility="{Binding HasBranch, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="&#xE8AD;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource FaintBrush}"
                                               VerticalAlignment="Center" Margin="0,1,4,0"/>
                                    <TextBlock Text="{Binding Branch}" FontSize="11.5" Foreground="{StaticResource FaintBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="190" ToolTip="Git branch"/>
                                </StackPanel>

                                <!-- Type chip + source -->
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Chip" CornerRadius="5" Padding="6,1,7,2" Background="{StaticResource IdleBrush}"
                                            BorderBrush="#33000000" BorderThickness="0,0,0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="ChipGlyph" Text="&#x263E;" FontFamily="Segoe UI Symbol" FontSize="10.5"
                                                       Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding StatusChip}" FontFamily="{StaticResource GameFont}" FontWeight="Bold"
                                                       FontSize="10.5" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Margin="5,0,0,0" Padding="4,1,4,2" CornerRadius="4" HorizontalAlignment="Left"
                                            BorderThickness="1" BorderBrush="#5A6290" VerticalAlignment="Center"
                                            Visibility="{Binding IsStale, Converter={StaticResource BoolToVis}}"
                                            ToolTip="No updates for 10 minutes">
                                        <TextBlock Text="STALE" FontFamily="{StaticResource GameFont}" FontWeight="Bold" FontSize="9"
                                                   Foreground="{StaticResource FaintBrush}"/>
                                    </Border>
                                    <Border Grid.Column="2" Padding="6,1,6,2" CornerRadius="5" VerticalAlignment="Center"
                                            Background="{StaticResource PillBrush}"
                                            Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Source}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                    </Border>
                                </Grid>

                                <!-- What it's doing -->
                                <TextBlock x:Name="ActivityText" Margin="0,7,0,0" Text="{Binding Activity, NotifyOnTargetUpdated=True}" TargetUpdated="ActivityText_TargetUpdated"
                                           FontSize="12.5"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           LineStackingStrategy="BlockLineHeight" LineHeight="17" MaxHeight="34">
                                    <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Text="{Binding Activity}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ActivityDetail}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="11" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>

                                <!-- Your last prompt, as a speech bubble -->
                                <Grid x:Name="PromptBox" Margin="0,7,0,0" Visibility="{Binding HasPrompt, Converter={StaticResource BoolToVis}}">
                                    <Path Data="M 8,0 L 14,6 L 2,6 Z" Fill="{StaticResource BubbleBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <Border Margin="0,5,0,0" CornerRadius="7" Padding="8,4,8,5" Background="{StaticResource BubbleBrush}">
                                        <TextBlock Text="{Binding LastPrompt}" ToolTip="{Binding LastPrompt}" FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   LineStackingStrategy="BlockLineHeight" LineHeight="16" MaxHeight="32"/>
                                    </Border>
                                </Grid>

                                <!-- HP (freshness) -->
                                <Grid x:Name="HpRow" Margin="0,8,0,0" ToolTip="HP shows how recently this session was active. It drains over 10 minutes of no activity, then the card is marked stale.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="3" Padding="4,0,4,1" Background="#0F1328">
                                        <TextBlock Text="HP" FontFamily="{StaticResource GameFont}" FontWeight="Bold" FontSize="9"
                                                   Foreground="{StaticResource SelectBrush}"/>
                                    </Border>
                                    <Border Grid.Column="1" Height="7" Margin="4,0,0,0" CornerRadius="3.5" Background="#0F1328"
                                            BorderBrush="#3A4478" BorderThickness="1" VerticalAlignment="Center">
                                        <Border x:Name="HpFill" CornerRadius="2.5" Background="{StaticResource HpHighBrush}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Hp}"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Border>
                                </Grid>

                                <TextBlock Margin="0,5,0,0" Text="{Binding TimeText}" FontSize="11.5" Foreground="{StaticResource FaintBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Battle dialog when it needs you -->
                            <Border x:Name="Dialog" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" CornerRadius="7"
                                    Background="#F7F5EA" BorderBrush="#0B0E1E" BorderThickness="2" Padding="3"
                                    Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVis}}">
                                <Border CornerRadius="5" BorderBrush="#7F8AC0" BorderThickness="1.5" Padding="8,5,8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <!-- Reserve the full text's height so the card doesn't grow while it types -->
                                            <Grid>
                                                <TextBlock Text="{Binding BattleText}" FontFamily="{StaticResource GameFont}" FontWeight="SemiBold"
                                                           FontSize="12.5" TextWrapping="Wrap" Visibility="Hidden"/>
                                                <TextBlock Text="{Binding TypedBattleText}" FontFamily="{StaticResource GameFont}" FontWeight="SemiBold"
                                                           FontSize="12.5" Foreground="#1D2140" TextWrapping="Wrap"/>
                                            </Grid>
                                            <TextBlock Text="Click to open it and answer" FontSize="11.5" Foreground="#4A5070" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Path x:Name="DialogArrow" Grid.Column="1" Data="M 0,0 L 9,0 L 4.5,6 Z" Fill="#FF6B4A"
                                              VerticalAlignment="Bottom" Margin="6,0,0,2">
                                            <Path.RenderTransform><TranslateTransform/></Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                </Border>
            </Grid>

            <DataTemplate.Triggers>
                <!-- Slide-in with a little spring -->
                <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="Root">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                             To="0" Duration="0:0:0.55">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <!-- Hover: selection border + bouncing menu cursor -->
                <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource SelectBrush}"/>
                    <Setter TargetName="DismissBtn" Property="Visibility" Value="Visible"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="CursorBounce">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Cursor" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetName="Cursor" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 From="0" To="3" Duration="0:0:0.35" AutoReverse="True" RepeatBehavior="Forever">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="CursorBounce"/>
                    </Trigger.ExitActions>
                </Trigger>

                <!-- WORKING: hop with squash and stretch, sparkles -->
                <DataTrigger Binding="{Binding Status}" Value="Working">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource WorkingBrush}"/>
                    <Setter TargetName="ChipGlyph" Property="Text" Value="&#x26A1;"/>
                    <Setter TargetName="Habitat" Property="Fill" Value="{StaticResource HabitatWorking}"/>
                    </DataTrigger>
                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Status}" Value="Working"/><Condition Binding="{Binding DataContext.CalmMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/></MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Hop">
                            <Storyboard>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Sprite" RepeatBehavior="Forever"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="-7"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseIn"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Sprite" RepeatBehavior="Forever"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.9"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.08"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1.02"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1.04"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.47" Value="0.86"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="1"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="0.9"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Sprite" RepeatBehavior="Forever"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.08"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0.94"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0.97"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.47" Value="1.12"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="1"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="1.08"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Shadow" RepeatBehavior="Forever"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0.65"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="1"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SparkA" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="1"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="0"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SparkB" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:0.45">
                                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="1"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="0"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SparkC" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:0.9">
                                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="1"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="0"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Hop"/>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>

                <!-- WAITING: shake, "!" pops, card glows, dialog arrow blinks -->
                <DataTrigger Binding="{Binding Status}" Value="Waiting">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource WaitingBrush}"/>
                    <Setter TargetName="ChipGlyph" Property="Text" Value="!"/>
                    <Setter TargetName="Habitat" Property="Fill" Value="{StaticResource HabitatWaiting}"/>
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource WaitingCardFill}"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource WaitingBrush}"/>
                    </DataTrigger>
                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Status}" Value="Waiting"/><Condition Binding="{Binding DataContext.CalmMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/></MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Alert">
                            <Storyboard>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Sprite" RepeatBehavior="Forever"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)">
                                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.07" Value="-10"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.14" Value="10"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.21" Value="-8"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.28" Value="8"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="0"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimation Storyboard.TargetName="Bang" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05"/>
                                <DoubleAnimation Storyboard.TargetName="Bang" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.35">
                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.8"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Bang" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.35">
                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.8"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Bang" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                 BeginTime="0:0:0.35" From="0" To="-3" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <ColorAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                From="#FF6B4A" To="#6E2A22" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="DialogArrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="0" To="2.5" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                 From="0.15" To="0.55" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Alert"/>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>

                <!-- FINISHED: spin jump + star burst, then a calm breath -->
                <DataTrigger Binding="{Binding Status}" Value="Finished">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource FinishedBrush}"/>
                    <Setter TargetName="ChipGlyph" Property="Text" Value="&#x2605;"/>
                    <Setter TargetName="Habitat" Property="Fill" Value="{StaticResource HabitatFinished}"/>
                    </DataTrigger>
                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Status}" Value="Finished"/><Condition Binding="{Binding DataContext.CalmMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/></MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Celebrate">
                            <Storyboard>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Sprite"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="-13"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0"><EasingDoubleKeyFrame.EasingFunction><BounceEase EasingMode="EaseOut" Bounces="2" Bounciness="3"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimation Storyboard.TargetName="Sprite" Duration="0:0:0.45" From="0" To="360"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Sprite" BeginTime="0:0:0.7" From="1" To="1.05" Duration="0:0:1.4"
                                    AutoReverse="True" RepeatBehavior="Forever"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <!-- star burst: each star flies out and fades -->
                                <DoubleAnimation Storyboard.TargetName="Star1" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.2" From="1" To="0" Duration="0:0:0.75"/>
                                <DoubleAnimation Storyboard.TargetName="Star1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" BeginTime="0:0:0.2" From="0" To="-24" Duration="0:0:0.75"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Star1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" BeginTime="0:0:0.2" From="0" To="-18" Duration="0:0:0.75"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Star2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.2" From="1" To="0" Duration="0:0:0.75"/>
                                <DoubleAnimation Storyboard.TargetName="Star2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" BeginTime="0:0:0.2" From="0" To="24" Duration="0:0:0.75"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Star2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" BeginTime="0:0:0.2" From="0" To="-20" Duration="0:0:0.75"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Star3" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.2" From="1" To="0" Duration="0:0:0.75"/>
                                <DoubleAnimation Storyboard.TargetName="Star3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" BeginTime="0:0:0.2" From="0" To="-28" Duration="0:0:0.75"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Star4" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.2" From="1" To="0" Duration="0:0:0.75"/>
                                <DoubleAnimation Storyboard.TargetName="Star4" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" BeginTime="0:0:0.2" From="0" To="-26" Duration="0:0:0.75"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Star4" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" BeginTime="0:0:0.2" From="0" To="6" Duration="0:0:0.75"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Star5" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.2" From="1" To="0" Duration="0:0:0.75"/>
                                <DoubleAnimation Storyboard.TargetName="Star5" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" BeginTime="0:0:0.2" From="0" To="26" Duration="0:0:0.75"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Star5" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" BeginTime="0:0:0.2" From="0" To="8" Duration="0:0:0.75"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Star6" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.3" From="1" To="0" Duration="0:0:0.7"/>
                                <DoubleAnimation Storyboard.TargetName="Star6" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" BeginTime="0:0:0.3" From="0" To="10" Duration="0:0:0.7"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Star6" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" BeginTime="0:0:0.3" From="0" To="-26" Duration="0:0:0.7"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Celebrate"/>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>

                <!-- IDLE: sleepy breathing and floating z's -->
                <DataTrigger Binding="{Binding Status}" Value="Idle">
                    </DataTrigger>
                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Status}" Value="Idle"/><Condition Binding="{Binding DataContext.CalmMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/></MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Snooze">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Sprite" From="1" To="0.93" Duration="0:0:1.6" AutoReverse="True" RepeatBehavior="Forever"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ZA" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:2.2" Value="0"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimation Storyboard.TargetName="ZA" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="4" To="-10" Duration="0:0:3.2" RepeatBehavior="Forever"/>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ZB" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:1.6">
                                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:2.2" Value="0"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimation Storyboard.TargetName="ZB" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 BeginTime="0:0:1.6" From="4" To="-10" Duration="0:0:3.2" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Snooze"/>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>

                <!-- ENDED: fainted -->
                <DataTrigger Binding="{Binding Status}" Value="Ended">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource EndedBrush}"/>
                    <Setter TargetName="ChipGlyph" Property="Text" Value="&#x2716;"/>
                    <Setter TargetName="Frame" Property="Opacity" Value="0.55"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Faint">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Sprite" To="90" Duration="0:0:0.5"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)">
                                    <DoubleAnimation.EasingFunction><BounceEase EasingMode="EaseOut" Bounces="1"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Faint"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsStale}" Value="True">
                    <Setter TargetName="Frame" Property="Opacity" Value="0.7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HpLevel}" Value="Mid">
                    <Setter TargetName="HpFill" Property="Background" Value="{StaticResource HpMidBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HpLevel}" Value="Low">
                    <Setter TargetName="HpFill" Property="Background" Value="{StaticResource HpLowBrush}"/>
                </DataTrigger>

                <!-- Calm mode: a still glow instead of a pulse -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="Waiting"/>
                        <Condition Binding="{Binding DataContext.CalmMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Glow" Property="Opacity" Value="0.35"/>
                    <Setter TargetName="Card" Property="BorderThickness" Value="2.5"/>
                </MultiDataTrigger>

                <!-- Finished: give the result three lines -->
                <DataTrigger Binding="{Binding Status}" Value="Finished">
                    <Setter TargetName="ActivityText" Property="MaxHeight" Value="51"/>
                </DataTrigger>

                <!-- Plain wording hides the game-only level -->
                <DataTrigger Binding="{Binding DataContext.PlainMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter TargetName="LevelBox" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>

                <!-- Compact cards: critter, name, status and activity only -->
                <DataTrigger Binding="{Binding DataContext.CompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter TargetName="AvatarColumn" Property="Width" Value="46"/>
                    <Setter TargetName="Avatar" Property="Width" Value="44"/>
                    <Setter TargetName="Avatar" Property="Height" Value="42"/>
                    <Setter TargetName="Habitat" Property="Width" Value="40"/>
                    <Setter TargetName="Habitat" Property="Height" Value="40"/>
                    <Setter TargetName="Sprite" Property="Width" Value="28"/>
                    <Setter TargetName="Sprite" Property="Height" Value="28"/>
                    <Setter TargetName="Sprite" Property="Margin" Value="0,0,0,8"/>
                    <Setter TargetName="Shadow" Property="Width" Value="18"/>
                    <Setter TargetName="Bang" Property="Canvas.Left" Value="28"/>
                    <Setter TargetName="Bang" Property="Canvas.Top" Value="4"/>
                    <Setter TargetName="Bang" Property="Width" Value="14"/>
                    <Setter TargetName="Bang" Property="Height" Value="16"/>
                    <Setter TargetName="SparkB" Property="Canvas.Left" Value="40"/>
                    <Setter TargetName="SparkC" Property="Canvas.Left" Value="40"/>
                    <Setter TargetName="ZA" Property="Canvas.Left" Value="34"/>
                    <Setter TargetName="ZB" Property="Canvas.Left" Value="38"/>
                    <Setter TargetName="LevelBox" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="PromptBox" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="HpRow" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Dialog" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ActivityText" Property="MaxHeight" Value="17"/>
                    <Setter TargetName="ActivityText" Property="Margin" Value="0,4,0,0"/>
                    <Setter TargetName="Root" Property="Margin" Value="14,0,12,7"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- Mini mode: one critter per session; only the ones with news move -->
        <DataTemplate x:Key="MiniCritter" DataType="{x:Type local:SessionInfo}">
            <Grid x:Name="Root" Width="56" Height="58" Margin="0,2,0,4" Cursor="Hand" Background="Transparent"
                  MouseLeftButtonUp="Card_Click">
                <Grid.ToolTip>
                    <StackPanel MaxWidth="280">
                        <TextBlock Text="{Binding Project}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatusLabel}"/>
                        <TextBlock Text="{Binding Activity}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock Text="Click to open" Margin="0,4,0,0" FontStyle="Italic"/>
                    </StackPanel>
                </Grid.ToolTip>
                <Ellipse x:Name="Ring" Width="48" Height="48" Fill="{StaticResource HabitatIdle}"
                         Stroke="{StaticResource IdleBrush}" StrokeThickness="2"/>
                <Image x:Name="Sprite" Source="{Binding CritterImage}" Width="34" Height="34" VerticalAlignment="Bottom" Margin="0,0,0,11"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" RenderTransformOrigin="0.5,1">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform/>
                            <RotateTransform/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <Border x:Name="Bang" Width="16" Height="18" CornerRadius="6" Background="#FFFFFF" BorderBrush="#0B0E1E" BorderThickness="1.2"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,0,0" Opacity="0" RenderTransformOrigin="0.3,1">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="0" ScaleY="0"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <TextBlock Text="!" FontFamily="{StaticResource GameFont}" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource WaitingBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="DoneBadge" Width="16" Height="16" CornerRadius="8" Background="{StaticResource FinishedBrush}"
                        BorderBrush="#0B0E1E" BorderThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock Text="&#x2605;" FontFamily="Segoe UI Symbol" FontSize="9" Foreground="{StaticResource InkBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Working">
                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource WorkingBrush}"/>
                    <Setter TargetName="Ring" Property="Fill" Value="{StaticResource HabitatWorking}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Waiting">
                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource WaitingBrush}"/>
                    <Setter TargetName="Ring" Property="StrokeThickness" Value="3"/>
                    <Setter TargetName="Ring" Property="Fill" Value="{StaticResource HabitatWaiting}"/>
                    <Setter TargetName="Bang" Property="Opacity" Value="1"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="Waiting"/>
                        <Condition Binding="{Binding DataContext.CalmMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard x:Name="MiniAlert">
                            <Storyboard>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Sprite" RepeatBehavior="Forever"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(RotateTransform.Angle)">
                                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.07" Value="-12"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.14" Value="12"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.21" Value="-9"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.28" Value="9"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="0"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Sprite" RepeatBehavior="Forever"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.55" Value="-6"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="0"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseIn"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimation Storyboard.TargetName="Bang" To="1" Duration="0:0:0.35"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.8"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Bang" To="1" Duration="0:0:0.35"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.8"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Bang" BeginTime="0:0:0.35" From="0" To="-3" Duration="0:0:0.4"
                                    AutoReverse="True" RepeatBehavior="Forever"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"/>
                                <ColorAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)"
                                                From="#FF6B4A" To="#6E2A22" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="MiniAlert"/>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
                <!-- Calm mode: the "!" still shows, just without motion -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="Waiting"/>
                        <Condition Binding="{Binding DataContext.CalmMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Bang" Property="RenderTransform">
                        <Setter.Value><TranslateTransform/></Setter.Value>
                    </Setter>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Finished">
                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource FinishedBrush}"/>
                    <Setter TargetName="Ring" Property="Fill" Value="{StaticResource HabitatFinished}"/>
                    <Setter TargetName="DoneBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="Finished"/>
                        <Condition Binding="{Binding DataContext.CalmMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard x:Name="MiniCheer">
                            <Storyboard>
                                <!-- three happy hops, then still -->
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Sprite" RepeatBehavior="3x"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="-9"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseIn"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.55" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="MiniCheer"/>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Ended">
                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource EndedBrush}"/>
                    <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsStale}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border BorderThickness="1,0,0,0" BorderBrush="#2B3360">
      <Grid>
        <!-- Mini view: a slim strip of critters -->
        <Grid x:Name="MiniView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,10,0,6" HorizontalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Width="30" Height="26" FontSize="11"
                        ToolTip="Expand the dock" Click="Expand_Click"/>
                <TextBlock Text="{Binding Sessions.Count}" FontFamily="{StaticResource GameFont}" FontWeight="Bold" FontSize="11"
                           Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"
                           ToolTip="Sessions"/>
                <Rectangle Height="1" Width="30" Fill="#2B3360" Margin="0,8,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource MiniCritter}" Focusable="False"
                              HorizontalAlignment="Center"/>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="FullView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Faint diagonal party-screen stripes -->
            <Rectangle Grid.RowSpan="3" Opacity="0.05" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="None">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#FFFFFF" Geometry="M 0,16 L 16,0 L 16,4 L 4,16 Z"/>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Header -->
            <StackPanel Margin="14,14,10,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="40" Height="40">
                        <Ellipse Fill="#2B3466"/>
                        <Image x:Name="LogoImage" Width="30" Height="30" RenderOptions.BitmapScalingMode="NearestNeighbor"
                               RenderTransformOrigin="0.5,1" Margin="0,0,0,2">
                            <Image.RenderTransform><TranslateTransform/></Image.RenderTransform>
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CalmMode}" Value="False">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="LogoBob">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         From="0" To="-2.5" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever">
                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="LogoBob"/></DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="SESSION DOCK" FontFamily="{StaticResource GameFont}" FontWeight="Bold" FontSize="17">
                            <!-- A shine sweeps across the title every few seconds -->
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.4">
                                    <GradientStop Color="#F1F3FF" Offset="-0.4"/>
                                    <GradientStop x:Name="ShineStop" Color="#FFE36E" Offset="-0.2"/>
                                    <GradientStop Color="#F1F3FF" Offset="0"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CalmMode}" Value="False">
                                            <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="TitleShine">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(LinearGradientBrush.GradientStops)[0].(GradientStop.Offset)"
                                                             From="-0.4" To="1.0" Duration="0:0:1.2" BeginTime="0:0:2"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(LinearGradientBrush.GradientStops)[1].(GradientStop.Offset)"
                                                             From="-0.2" To="1.2" Duration="0:0:1.2" BeginTime="0:0:2"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(LinearGradientBrush.GradientStops)[2].(GradientStop.Offset)"
                                                             From="0" To="1.4" Duration="0:0:1.2" BeginTime="0:0:2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="TitleShine"/></DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Summary}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTip="Each card is one Claude Code session: a terminal running claude, or a chat in the desktop app. It shows what Claude (the agent) is doing in that session right now."/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="Push the dock in (mini mode)" Click="Collapse_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Hide to tray" Click="Hide_Click"/>
                    </StackPanel>
                </Grid>

                <Border Margin="0,12,0,0" CornerRadius="9" Background="#0F1328" BorderBrush="#2B3360" BorderThickness="1" Padding="10,7,8,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PARTY" FontFamily="{StaticResource GameFont}" FontWeight="Bold" FontSize="10.5"
                                   Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource PartyBall}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Grid.Column="1" Text="empty" FontSize="11" FontStyle="Italic" Foreground="{StaticResource FaintBrush}"
                                   VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Party members -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" Padding="0,2,0,2">
                <ItemsControl ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource SessionCard}" Focusable="False"/>
            </ScrollViewer>

            <!-- Empty state: a sleeping critter -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="30,0,30,70"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <Grid Width="96" Height="80">
                    <Ellipse Width="80" Height="80" Fill="#1F2650"/>
                    <Image x:Name="EmptyImage" Width="56" Height="56" RenderOptions.BitmapScalingMode="NearestNeighbor"
                           VerticalAlignment="Bottom" Margin="0,0,0,10" RenderTransformOrigin="0.5,1">
                        <Image.RenderTransform><ScaleTransform/></Image.RenderTransform>
                        <Image.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         From="1" To="0.92" Duration="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Image.Triggers>
                    </Image>
                    <TextBlock Text="z Z" FontFamily="{StaticResource GameFont}" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource IdleBrush}" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="6" To="-6" Duration="0:0:2.4"/>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1"/>
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.4" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </Grid>
                <TextBlock Margin="0,14,0,0" Text="No sessions yet" FontFamily="{StaticResource GameFont}" FontWeight="SemiBold" FontSize="16"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Text="Start Claude Code in a terminal or in the desktop app. Each session joins your party here."/>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#2B3360" Padding="14,8,14,10" Background="#0C0F20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource HpHighBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PortText" Grid.Column="1" Margin="7,0,0,0" FontSize="11.5" Foreground="{StaticResource FaintBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"
                               Text="Options" ToolTip="Right-click the Session Dock tray icon for Compact cards, Calm mode and Plain wording"
                               TextDecorations="Underline" Cursor="Hand" MouseLeftButtonUp="Options_Click"/>
                </Grid>
            </Border>
        </Grid>
      </Grid>
    </Border>
</Window>
